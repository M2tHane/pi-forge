{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-forge/merge-queue.schema.json",
  "type": "object",
  "required": [
    "queue",
    "merging",
    "version"
  ],
  "properties": {
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flow",
          "task",
          "enqueued_at"
        ],
        "properties": {
          "flow": {
            "type": "string"
          },
          "task": {
            "type": "string",
            "pattern": "^T-\\d{3,}(\\.(at|rv|fx)(-\\d+)?)?$"
          },
          "enqueued_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "merging": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "flow",
            "task",
            "started_at"
          ],
          "properties": {
            "flow": {
              "type": "string"
            },
            "task": {
              "type": "string",
              "pattern": "^T-\\d{3,}(\\.(at|rv|fx)(-\\d+)?)?$"
            },
            "started_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "suspended": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flow",
          "task",
          "merge_fix",
          "since"
        ],
        "properties": {
          "flow": {
            "type": "string"
          },
          "task": {
            "type": "string",
            "pattern": "^T-\\d{3,}(\\.(at|rv|fx)(-\\d+)?)?$"
          },
          "merge_fix": {
            "type": "string",
            "pattern": "^T-\\d{3,}(\\.(at|rv|fx)(-\\d+)?)?$"
          },
          "since": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
