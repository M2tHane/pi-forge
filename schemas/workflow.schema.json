{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-forge/workflow.schema.json",
  "type": "object",
  "required": [
    "version",
    "project",
    "main_branch",
    "commands",
    "limits",
    "models",
    "modes",
    "scopes",
    "tool_groups",
    "roles"
  ],
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "main_branch": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_parallel",
        "max_attempts",
        "lease_minutes",
        "max_violations_per_run",
        "max_task_files",
        "fix_max_files"
      ],
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_aux": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_precheck_failures": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "max_merge_failures": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "lean_below_loc": {
          "type": "integer",
          "minimum": 1
        },
        "port_block": {
          "type": "integer",
          "minimum": 1
        },
        "lease_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_violations_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "max_task_files": {
          "type": "integer",
          "minimum": 1
        },
        "fix_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "session_retention_days": {
          "type": "integer",
          "minimum": 1
        },
        "continue_session": {
          "type": "boolean"
        },
        "bash_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "auto_dispatch": {
          "type": "boolean"
        },
        "merge_batch": {
          "type": "integer",
          "minimum": 1
        },
        "run_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "run_grace_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_continuations": {
          "type": "integer",
          "minimum": 0
        },
        "module_runs": {
          "type": "integer",
          "minimum": 1
        },
        "module_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "stall_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_review": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string",
              "const": "orchestrator"
            }
          ]
        },
        "checkpoint_minutes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "gui_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modes": {
      "type": "object",
      "properties": {
        "build": {
          "type": "object",
          "required": [
            "stages"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "gate"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "enum": [
                      "spec",
                      "plan",
                      "implementation"
                    ]
                  },
                  "gate": {
                    "type": "object",
                    "properties": {
                      "human": {
                        "type": "boolean"
                      },
                      "auto": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "all_tasks_done": {
                        "type": "boolean"
                      },
                      "coverage": {
                        "type": "boolean"
                      },
                      "qa": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "feature": {
          "type": "object",
          "required": [
            "stages"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "gate"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "enum": [
                      "spec",
                      "plan",
                      "implementation"
                    ]
                  },
                  "gate": {
                    "type": "object",
                    "properties": {
                      "human": {
                        "type": "boolean"
                      },
                      "auto": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "all_tasks_done": {
                        "type": "boolean"
                      },
                      "coverage": {
                        "type": "boolean"
                      },
                      "qa": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "implementation_gate": {
      "type": "object",
      "properties": {
        "human": {
          "type": "boolean"
        },
        "auto": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "all_tasks_done": {
          "type": "boolean"
        },
        "coverage": {
          "type": "boolean"
        },
        "qa": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "generated_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acctest_workspace": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cache": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "writes"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "tool_groups": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "model",
            "tools"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bash": {
              "enum": [
                "full",
                "readonly",
                "allowlist"
              ]
            },
            "bash_allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "read_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            },
            "escalate_model": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "escalation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "after_failures": {
          "type": "integer",
          "minimum": 1
        },
        "critical_fanout": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "testing": {
      "type": "object",
      "properties": {
        "adjust_tests": {
          "type": "boolean"
        },
        "max_disputes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "auto_candidates": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "per_task": {
          "type": "boolean"
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "skip_sizes": {
          "type": "array",
          "items": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "notify": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "compact_at": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 0.95
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "warn_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
