{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-forge/amend.schema.json",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "path",
    "content",
    "reason",
    "status",
    "diff",
    "affected_tasks",
    "base_sha",
    "created_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^A-[0-9]{3,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^docs/spec/features/[^/]+\\.md$"
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ]
    },
    "diff": {
      "type": "object",
      "required": [
        "added",
        "changed",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "affected_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-\\d{3,}(\\.(at|rv|fx)(-\\d+)?)?$"
      }
    },
    "base_sha": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "minLength": 1
    },
    "feedback": {
      "type": "string"
    },
    "sha": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
