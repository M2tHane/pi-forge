{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-forge/plan.schema.json",
  "type": "object",
  "required": [
    "stages",
    "tasks"
  ],
  "properties": {
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal",
          "exit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "exit": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "title",
          "layers",
          "ac",
          "writes",
          "produces",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ac": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "shared": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "manual_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "maxItems": 20
          },
          "risk": {
            "enum": [
              "low",
              "normal",
              "high"
            ]
          },
          "modifies": {
            "type": "string",
            "pattern": "^T-\\d{3,}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
