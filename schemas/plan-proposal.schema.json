{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-forge/plan-proposal.schema.json",
  "type": "object",
  "required": [
    "version",
    "task",
    "plan_hash",
    "assumptions",
    "extras",
    "report",
    "warnings",
    "created_at"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "task": {
      "type": "string",
      "pattern": "^(T-\\d{3,}(\\.(at|rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.(rv|qa)(-\\d+)?)$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "decision"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "report": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
