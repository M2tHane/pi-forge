{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi-forge/task.schema.json",
  "type": "object",
  "required": [
    "id",
    "stage",
    "kind",
    "title",
    "role",
    "scopes",
    "depends_on",
    "inputs",
    "writes",
    "verify",
    "status",
    "attempts",
    "violations",
    "lease_expirations",
    "lease",
    "impl_run",
    "branch",
    "worktree",
    "base_sha",
    "blocked_reason",
    "last_failure",
    "created_by",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "impl",
        "doc",
        "review",
        "qa",
        "fix",
        "merge-fix"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "type"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
          },
          "type": {
            "type": "string",
            "const": "hard"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "page": {
      "type": "string",
      "minLength": 1
    },
    "ac": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_interface": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "enum": [
        "skip",
        "auto",
        "strong"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "for_task": {
      "type": "string",
      "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
    },
    "source_round": {
      "type": "object",
      "required": [
        "task",
        "round"
      ],
      "properties": {
        "task": {
          "type": "string",
          "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "in_review",
        "queued_merge",
        "merging",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "review_rounds": {
      "type": "integer",
      "minimum": 0
    },
    "merge_failures": {
      "type": "integer",
      "minimum": 0
    },
    "blocked_by": {
      "anyOf": [
        {
          "enum": [
            "review_exhausted",
            "merge_exhausted",
            "attempts",
            "agent",
            "dispatcher",
            "user",
            "integration_broken",
            "no_changes"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_owner": {
      "type": "string",
      "const": "orchestrator"
    },
    "decisions": {
      "type": "integer",
      "minimum": 0
    },
    "violations": {
      "type": "integer",
      "minimum": 0
    },
    "lease_expirations": {
      "type": "integer",
      "minimum": 0
    },
    "interruptions": {
      "type": "integer",
      "minimum": 0
    },
    "same_failures": {
      "type": "integer",
      "minimum": 0
    },
    "failure_sig": {
      "type": "string"
    },
    "timeouts": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_review": {
      "type": "object",
      "required": [
        "run",
        "at",
        "minutes"
      ],
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        },
        "last_text": {
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "type": "string",
              "const": "continue"
            },
            {
              "type": "string",
              "const": "restart"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "timeout_progress": {
      "type": "object",
      "required": [
        "commits",
        "lines",
        "decision"
      ],
      "properties": {
        "commits": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "decision": {
          "anyOf": [
            {
              "type": "string",
              "const": "continue"
            },
            {
              "type": "string",
              "const": "restart"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "size": {
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "manual_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 20
    },
    "lease": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "run_id",
            "role",
            "token_hash",
            "acquired_at",
            "expires_at"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "token_hash": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "acquired_at": {
              "type": "string",
              "minLength": 1
            },
            "expires_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "impl_run": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "worktree": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_fix_for": {
      "type": "string",
      "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
    },
    "conflict_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sync_main": {
      "type": "string",
      "minLength": 1
    },
    "fork_from_task": {
      "type": "string",
      "pattern": "^(T-\\d{3,}(\\.(rv|fx)(-\\d+)?)?|[A-Za-z][A-Za-z0-9_]*\\.qa(-\\d+)?)$"
    },
    "test_adjustments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
